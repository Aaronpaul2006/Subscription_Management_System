# Copy to .env (never commit .env) or set these in your hosting environment.

# --- Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TIME_ZONE=Asia/Kolkata

# --- Database (default: SQLite file backend/db.sqlite3)
# DATABASE_URL=postgres://billing:billing@127.0.0.1:5432/billing

# --- Email. Without EMAIL_HOST every email is kept in the admin Outbox only.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Brightloop Billing <billing@brightloop.test>
# Links in emails (password reset, invoices) point here.
FRONTEND_URL=http://127.0.0.1:5173

# --- Business
COMPANY_NAME=Brightloop Software
COMPANY_ADDRESS=42 Residency Road, Bengaluru 560025, India
COMPANY_EMAIL=billing@brightloop.test
COMPANY_TAX_ID=29ABCDE1234F1Z5
CURRENCY=INR
CURRENCY_SYMBOL=₹
DUNNING_INTERVAL_DAYS=7
